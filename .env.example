APP_NAME=DocQA
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL + pgvector is the recommended vector store (`docker compose up -d`):
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=docqa
# DB_USERNAME=docqa
# DB_PASSWORD=docqa
# SQLite / MySQL also work, using an exact brute-force cosine scan in PHP.
DB_CONNECTION=sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# Must exceed ProcessDocument::$timeout (300s) so a slow ingest isn't picked up twice.
DB_QUEUE_RETRY_AFTER=360

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- LLM (answers) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max
ANTHROPIC_EFFORT=low
# Grades answers in rag:eval-answers; empty means ANTHROPIC_MODEL
RAG_JUDGE_MODEL=claude-sonnet-5-5

# --- Embeddings ---
# voyage (hosted) | ollama (local) | hash (offline lexical baseline, no key needed)
EMBEDDING_PROVIDER=voyage
# Baked into the pgvector column: changing it requires `migrate:fresh` + `rag:reindex`.
# voyage-3.5 → 1024 (also 256/512/2048) · nomic-embed-text → 768
EMBEDDING_DIMENSIONS=1024
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3.5
OLLAMA_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text

# --- Retrieval ---
RAG_CHUNK_SIZE=1200
RAG_CHUNK_OVERLAP=200
RAG_TOP_K=6
RAG_CANDIDATES=20
RAG_HYBRID=true
RAG_FUSION=weighted
RAG_VECTOR_WEIGHT=0.6
RAG_MIN_SCORE=0.0
RAG_REWRITE_QUERIES=true
# claude (small Claude model, counts against the token limits) | voyage (needs VOYAGE_API_KEY) | none
RAG_RERANKER=claude
RAG_RERANK_CANDIDATES=20
RAG_RERANK_MODEL=claude-haiku-5-5

# --- Accounts and usage limits (0 = unlimited) ---
DOCQA_REGISTRATION=true
DOCQA_VERIFY_EMAIL=false
RAG_UPLOADS_PER_HOUR=30
RAG_QUESTIONS_PER_MINUTE=30
RAG_DAILY_TOKENS_PER_USER=300000
RAG_DAILY_TOKENS_TOTAL=3000000
